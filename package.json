{
  "name": "trajectory-life-tracker",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "audit:dependencies": "npm audit --audit-level=high",
    "check": "npm run check:architecture && npm run test:delivery && npm run lint && npm run lint:styles && npm run format:check && npm test && npm run build && npm run check:dist && npm run storybook:build",
    "test:delivery": "node --test scripts/ci/*-check.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:dist": "node scripts/check-built-app.mjs",
    "commitlint": "commitlint",
    "demo:generate": "node scripts/generate-test-user-data.mjs",
    "dev": "vite",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "landing:capture": "node scripts/capture-landing-media.mjs",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.css\" && node scripts/check-style-colors.mjs && node scripts/check-style-boundaries.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --fail-on-flaky-tests",
    "test:staging": "node scripts/staging/verify.mjs",
    "test:performance": "npm run demo:generate && npm run build && playwright test --config playwright.performance.config.ts",
    "test:watch": "vitest",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "dexie": "^4.2.1",
    "echarts": "^6.1.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/vue3-vite": "^10.5.3",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "storybook": "^10.5.3",
    "stylelint": "^17.14.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.8"
  }
}
